import numpy as np
import pyvista as pv


def create_cube_sphere(resolution=50, radius=100.0):

    # Coordinates along each cube edge
    u = np.linspace(-1.0, 1.0, resolution + 1)

    # Six cube faces
    faces = [
        lambda a, b: (np.ones_like(a), a, b),
        lambda a, b: (-np.ones_like(a), a, b),

        lambda a, b: (a, np.ones_like(a), b),
        lambda a, b: (a, -np.ones_like(a), b),

        lambda a, b: (a, b, np.ones_like(a)),
        lambda a, b: (a, b, -np.ones_like(a)),
    ]

    meshes = []

    for face in faces:

        a, b = np.meshgrid(u, u, indexing="ij")

        x, y, z = face(a, b)

        # Convert cube face into a structured grid
        grid = pv.StructuredGrid(x, y, z)

        # Extract surface and triangulate
        surface = grid.extract_surface().triangulate()

        meshes.append(surface)

    # Combine all six faces
    planet = pv.merge(meshes, merge_points = True)

    # Clean duplicate points.
    planet = planet.clean(tolerance=1e-8)

    # Merge vertices shared between cube faces
    planet = planet.clean(tolerance=1e-8)

    # Project cube vertices onto a sphere
    points = planet.points.copy()

    directions = points / np.linalg.norm(
        points, axis=1
    )[:, None]

    # Set spherical positions
    planet.points = directions * radius

    return planet

planet = create_cube_sphere(resolution=100, radius=100)
planet.plot(show_edges=True)

def generate_height(directions):

    x = directions[:, 0]
    y = directions[:, 1]
    z = directions[:, 2]

    height = (
        2.0 * np.sin(x * 12.0) *
        np.cos(y * 12.0) +

        1.5 * np.sin(z * 20.0) *
        np.cos(x * 15.0)
    )

    return height

def displace_planet(planet, radius=100.0):

    directions = planet.points.copy()

    directions /= np.linalg.norm(
        directions, axis=1
    )[:, None]

    heights = generate_height(directions)

    planet.point_data["height"] = heights

    planet.points = directions * (
        radius + heights
    )

    planet = planet.compute_normals(
        point_normals=True,
        cell_normals=False,
        inplace=False
    )

    return planet

planet = create_cube_sphere(100, 100)
planet = displace_planet(planet, 100)

planet.plot(scalars="height", cmap="terrain", smooth_shading=True)